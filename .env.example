# ==========================================
# GymFlow-v2 Database Configuration
# ==========================================
# Database type: 'mysql' or 'sqlite'
DB_TYPE=mysql

# MySQL Server Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=gym_user
DB_PASSWORD=gym_password
DB_NAME=gym_flow

# Fallback Settings
# When SQLITE_FALLBACK is true, GymFlow automatically falls back
# to local SQLite if MySQL server is unreachable offline.
SQLITE_FALLBACK=true
SQLITE_PATH=gym.db
